# Real-Time Voice Assistant Configuration

# 1. Deepgram Streaming STT (Get key from https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# 2. Google Gemini API (Get key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. ElevenLabs Streaming TTS (Get key from https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Server Config
HOST=0.0.0.0
PORT=8000
DEBUG=true
